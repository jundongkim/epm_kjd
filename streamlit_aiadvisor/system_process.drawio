                <mxCell id="t4O0_456r1OKbWzrMn9D-17" value="&lt;b&gt;인과 관계 (Causal Relations)&lt;/b&gt;&lt;br&gt;- caused_by: 원인-결과 관계 (문제 원인)&lt;br&gt;- resulted_in: 결과 관계 (문제 결과)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=5;fontColor=#333333;fontFamily=paperlogy;" vertex="1" parent="1">
