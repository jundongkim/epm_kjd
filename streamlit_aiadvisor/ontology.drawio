                    <mxGeometry x="648" y="672" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="query_class" value="&lt;b&gt;Query (질의)&lt;/b&gt;&lt;br&gt;- queryId: 질의 식별자&lt;br&gt;- content: 질의 내용&lt;br&gt;- timestamp: 시간 정보&lt;br&gt;- source: 질의 출처&lt;br&gt;- status: 질의 상태" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=5;fontFamily=paperlogy;" parent="1" vertex="1">
                    <mxGeometry x="37" y="845" width="220" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="response_class" value="&lt;b&gt;Response (응답)&lt;/b&gt;&lt;br&gt;- responseId: 응답 식별자&lt;br&gt;- content: 응답 내용&lt;br&gt;- timestamp: 시간 정보&lt;br&gt;- confidence: 신뢰도&lt;br&gt;- sources: 참조 소스" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=5;fontFamily=paperlogy;" parent="1" vertex="1">
                    <mxGeometry x="408" y="845" width="220" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="report_class" value="&lt;b&gt;Report (보고서)&lt;/b&gt;&lt;br&gt;- reportId: 보고서 식별자&lt;br&gt;- title: 보고서 제목&lt;br&gt;- creationDate: 생성일자&lt;br&gt;- summary: 요약 내용&lt;br&gt;- type: 보고서 유형&lt;br&gt;- format: 형식" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=5;fontFamily=paperlogy;" parent="1" vertex="1">
                    <mxGeometry x="744" y="845" width="220" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="ontology_creation_process" value="&lt;b&gt;온톨로지 생성 프로세스&lt;/b&gt;&lt;br&gt;1. 문서 파싱: 구조, 섹션, 콘텐츠 식별&lt;br&gt;2. 전체 내용 추출: 문서의 모든 콘텐츠 추출 및 저장&lt;br&gt;3. 정보 추출: LLM 모델이 중요 개념, 엔티티, 관계 추출&lt;br&gt;4. 메타데이터 관리: 문서 속성 및 정보 구조화&lt;br&gt;5. 관계 모델링: 개념 간, 문서 간 관계 정의&lt;br&gt;6. TTL 변환: 온톨로지를 RDF/TTL 형식으로 저장" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;spacingLeft=5;fontFamily=paperlogy;" parent="1" vertex="1">
                    <mxGeometry x="66" y="1039" width="320" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="advisor_usage" value="&lt;b&gt;어드바이저에서의 온톨로지 활용&lt;/b&gt;&lt;br&gt;1. 질의 분석: 사용자 질의에서 핵심 개념 추출&lt;br&gt;2. 관계 탐색: 개념 간 관계를 통한 맥락 이해&lt;br&gt;3. 관련 문서 검색: 개념과 관련된 문서 섹션 탐색&lt;br&gt;4. 증거 수집: 질의 관련 증거를 온톨로지 그래프에서 수집&lt;br&gt;5. 전체 문서 내용 검색: 필요시 원본 전체 내용 참조&lt;br&gt;6. 응답 생성: LLM이 온톨로지 정보를 기반으로 응답 생성" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;spacingLeft=5;fontFamily=paperlogy;" parent="1" vertex="1">
                    <mxGeometry x="406" y="1039" width="320" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="fault_analysis_usage" value="&lt;b&gt;제조 불량 분석에서의 온톨로지 활용&lt;/b&gt;&lt;br&gt;1. 불량 분류: 불량 현상을 유형별로 분류&lt;br&gt;2. 원인 추적: 인과 관계를 통한 근본 원인 파악&lt;br&gt;3. 연관 장비/부품 식별: 불량과 연관된 설비 및 부품 식별&lt;br&gt;4. 유사 사례 검색: 과거 유사 불량 사례 검색&lt;br&gt;5. 전체 문서 내용 기반 RCA: 상세 원인 분석 수행&lt;br&gt;6. 개선 방안 도출: 유사 사례의 해결책 참조" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;spacingLeft=5;fontFamily=paperlogy;" parent="1" vertex="1">
                    <mxGeometry x="746" y="1039" width="320" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="key_benefits" value="&lt;b&gt;온톨로지 활용의 주요 이점&lt;/b&gt;&lt;br&gt;1. 맥락 인식: 단순 키워드 매칭을 넘어선 의미적 이해&lt;br&gt;2. 추론 능력: 명시적 정보를 넘어 암묵적 관계 추론&lt;br&gt;3. 투명성: 응답 및 보고서의 근거 명확히 제시&lt;br&gt;4. 일관성: 다양한 문서 간 통합된 지식 표현&lt;br&gt;5. 원본 참조: 필요시 원본 전체 내용에 접근 가능&lt;br&gt;6. 확장성: 새로운 문서와 개념을 지속적으로 통합 가능" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;spacingLeft=5;fontFamily=paperlogy;" parent="1" vertex="1">
                    <mxGeometry x="406" y="1179" width="320" height="120" as="geometry"/>
                </mxCell>
