                <mxCell id="equipment_relations" value="&lt;b&gt;장비/공정 관계&lt;/b&gt;&lt;br&gt;- used_in: 사용 관계 (장비/도구 사용)&lt;br&gt;- part_of: 부분-전체 관계 (장비 구성)&lt;br&gt;- connected_to: 연결 관계 (배관/장비)&lt;br&gt;- measured_by: 측정 관계 (센서/계측기)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=5;fontColor=#333333;fontFamily=paperlogy;" parent="1" vertex="1">
